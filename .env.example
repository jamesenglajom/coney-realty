# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SUPABASE
# Client-safe (exposed to the browser, must keep the NEXT_PUBLIC_ prefix):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never import in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# RECAPTCHA (v3, invisible/score-based) — Schedule a Viewing and future public forms.
# Client-safe:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never import in a Client Component.
RECAPTCHA_SECRET_KEY=
